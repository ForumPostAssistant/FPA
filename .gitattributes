# -------------------------------------------------------------------------
# Line Ending Normalisation (Ensures cross-platform code safety)
# -------------------------------------------------------------------------
* text=auto
*.php text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf

# -------------------------------------------------------------------------
# Release Archive Exclusions (Stripped from the downloaded zip)
# -------------------------------------------------------------------------
# Exclude the complete language localization directory
/lang/ export-ignore

# Exclude Git system and workflow files
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore

# Exclude IDE or OS system files if they accidentally slip in
.DS_Store export-ignore
.idea/ export-ignore
.vscode/ export-ignore

# Exclude repo-level dev documentation and project setup files
CONTRIBUTING.md export-ignore
CHANGELOG.md export-ignore
composer.json export-ignore
composer.lock export-ignore
package.json export-ignore

# Exclude testing environments (adjust paths if your folders are named differently)
/fpa-simulation-datasets/ export-ignore
/tests/ export-ignore
phpunit.xml export-ignore
